PORT=5000

# SQL Login connection. Keep DB_PASSWORD in the process environment or a
# secret manager; never commit the real value to this file or to .env.
DB_HOST=localhost
DB_PORT=1433
DB_NAME=BRAVO_HRM
DB_USER=sa
DB_PASSWORD=
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true

# Required for stable sessions in deployed environments.
JWT_SECRET=

# Pinata stores employee avatars on public IPFS. Keep the JWT on the server
# only; never expose it through NEXT_PUBLIC_ variables.
PINATA_JWT=
PINATA_GATEWAY_URL=https://your-gateway.mypinata.cloud
