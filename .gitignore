# --- Dependencies ---
node_modules/
client/node_modules/
server/node_modules/
next-app/node_modules/

# --- Biến môi trường / Secret - TUYỆT ĐỐI không đẩy lên Git ---
.env
.env.local
client/.env
server/.env

# --- Database - chứa dữ liệu thật, không nên đẩy lên Git ---
server/hrm.db
server/hrm.db-journal
*.db
*.db-journal

# --- Build output ---
client/dist/
dist/
next-app/.next/
next-app/out/
**/.vite/
**/.cache/
coverage/
*.tsbuildinfo

# --- Log files ---
*.log
npm-debug.log*

# --- Visual Studio / Visual Studio Code ---
.vs/
.vscode/
*.user

# --- OS files ---
.DS_Store
Thumbs.db

# --- Upload files (nếu không muốn đẩy file người dùng tải lên) ---
server/uploads/*
!server/uploads/.gitkeep
